generator client {
  provider = "prisma-client-js"
}

// SQLite by default so the platform runs without external services.
// For production set provider = "postgresql" and point DATABASE_URL at your cluster.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Platform-wide configuration, edited by the super admin through the admin UI
/// rather than through the environment, because a running server cannot write
/// to its own .env. Exactly one row exists, keyed by PLATFORM_SETTINGS_ID.
model PlatformSettings {
  id String @id

  // Stripe — cards for OmniFlow plan purchases.
  stripeEnabled      Boolean @default(false)
  stripeSecretKey    String? // encrypted
  stripePriceStarter String?
  stripePricePro     String?
  stripePriceAgency  String?

  // bKash — manual transfer to a personal number, verified by the admin.
  bkashEnabled      Boolean @default(false)
  bkashNumber       String?
  bkashInstructions String?
  /// BDT charged per 1 USD of plan price. Plans are priced in USD; bKash only
  /// moves BDT, so an amount cannot be quoted without this.
  bkashUsdRate      Float?

  // Meta connector — one shared app for Facebook login and page connection.
  metaEnabled      Boolean @default(false)
  metaAppId        String? // public by design: it appears in the OAuth URL
  metaAppSecret    String? // encrypted
  metaVerifyToken  String? // encrypted
  metaGraphVersion String  @default("v21.0")

  /// Reserved for creator-store selling, which is not enabled yet. While this
  /// is false no store gateway is offered and paid products cannot be bought.
  storePaymentsEnabled Boolean @default(false)
  /// Commission on creator-store sales. Unused until store selling ships.
  platformFeePercent   Float   @default(0)

  updatedByEmail String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model User {
  id                  String  @id @default(cuid())
  email               String  @unique
  /// Null for accounts created through Facebook that never set a password.
  passwordHash        String?
  fullName            String
  username            String  @unique
  headline            String?
  bio                 String?
  avatar              String?
  cover               String?
  category            String?
  primaryGoal         String?
  onboardingCompleted Boolean @default(false)

  plan                 String    @default("starter")
  planStatus           String    @default("trialing") // trialing | active | past_due | canceled
  trialEndsAt          DateTime?
  /// Set for manually paid plans, which do not auto-renew. Past this date the
  /// account falls back to Starter entitlements.
  planPeriodEnd        DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?

  products       Product[]
  autoRules      AutoDMRule[]
  orders         Order[]
  funnelEvents   FunnelEvent[]
  metaAccounts   MetaAccount[]
  dmLogs         DmLog[]
  bookings       Booking[]
  uploads        Upload[]
  socialAccounts SocialAccount[]
  manualPayments ManualPayment[]
  payouts        Payout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Links an external identity provider account to an OmniFlow user. Linking
/// only ever happens from an authenticated session or a first-time signup, so
/// a provider-asserted email can never take over an existing password account.
model SocialAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // "facebook"
  providerAccountId String
  email             String?
  name              String?
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// A buyer-declared offline payment awaiting super-admin verification.
model ManualPayment {
  id      String @id @default(cuid())
  kind    String // "subscription" | "order"
  gateway String @default("bKash")

  userId  String?
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan    String?
  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Normalised to trimmed uppercase. Unique so one transaction can never be
  /// claimed twice.
  trxId        String @unique
  senderNumber String
  /// Always computed server-side from the plan or order, never accepted from
  /// the submitter.
  amountCents  Int
  currency     String @default("BDT")

  status     String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedBy String?
  reviewedAt DateTime?
  reviewNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

/// Record of money sent to a creator off-platform. Unused until creator-store
/// selling ships; kept so enabling it needs no second migration.
model Payout {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCents    Int
  currency       String
  note           String?
  createdByEmail String?
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}

model Product {
  id          String  @id @default(cuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  type        String // "digital_file" | "consultation"
  price       Float
  currency    String  @default("$")
  badge       String?
  description String
  thumbnail   String?
  active      Boolean @default(true)

  // digital_file
  fileKey  String?
  fileName String?
  fileSize Int?
  fileMime String?

  // consultation
  meetingLink     String?
  durationMinutes Int?

  salesCount Int                @default(0)
  autoRules  AutoDMRule[]
  orders     Order[]
  slots      ConsultationSlot[]
  bookings   Booking[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([userId, createdAt])
}

/// Ownership record for every file written to disk, so a creator can only
/// attach deliverables and images that they uploaded themselves.
model Upload {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bucket    String // "public" | "private"
  key       String   @unique
  name      String
  mime      String
  size      Int
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model ConsultationSlot {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  booked    Boolean  @default(false)
  booking   Booking?
  createdAt DateTime @default(now())

  @@unique([productId, startsAt])
  @@index([productId, startsAt])
}

model MetaAccount {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform       String // "facebook" | "instagram"
  pageId         String       @unique
  pageName       String
  igUserId       String?      @unique
  accessToken    String // encrypted
  tokenExpiresAt DateTime?
  subscribed     Boolean      @default(false)
  /// Set when the admin rotates the Meta app credentials: tokens issued by the
  /// previous app are dead and the creator has to reconnect.
  needsReconnect Boolean      @default(false)
  autoRules      AutoDMRule[]
  dmLogs         DmLog[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model AutoDMRule {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform        String // "facebook" | "instagram"
  keyword         String
  targetProductId String
  targetProduct   Product      @relation(fields: [targetProductId], references: [id], onDelete: Cascade)
  metaAccountId   String?
  metaAccount     MetaAccount? @relation(fields: [metaAccountId], references: [id], onDelete: SetNull)
  autoMessage     String
  triggerCount    Int          @default(0)
  active          Boolean      @default(true)
  dmLogs          DmLog[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([userId, platform, keyword])
  @@index([userId, keyword])
}

model DmLog {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  ruleId        String?
  rule          AutoDMRule?  @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  metaAccountId String?
  metaAccount   MetaAccount? @relation(fields: [metaAccountId], references: [id], onDelete: SetNull)
  platform      String
  commentId     String
  keyword       String
  status        String // "sent" | "failed" | "quota_exceeded" | "window_expired"
  error         String?
  latencyMs     Int?
  createdAt     DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([commentId])
}

model Order {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId         String
  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerName      String
  customerEmail     String
  customerPhone     String?
  amountCents       Int
  currency          String    @default("USD")
  pricePaid         String
  gateway           String // "Stripe" | "bKash" | "Free"
  status            String    @default("PENDING") // PENDING | PAID | FAILED | REFUNDED
  gatewayRef        String?   @unique
  /// The payment identifier rather than the checkout session, for reconciliation.
  gatewayPaymentRef String?
  slotId            String?
  deliveredAt       DateTime?

  // Earnings columns for creator-store selling, which is not enabled yet. They
  // stay zero until store payments ship, so enabling them needs no migration.
  platformFeeCents Int       @default(0)
  netCents         Int       @default(0)
  payoutStatus     String    @default("UNPAID") // UNPAID | PAID
  paidOutAt        DateTime?

  downloadToken DownloadToken?
  booking       Booking?
  deliveryLogs  DeliveryLog[]
  manualPayment ManualPayment?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([userId, payoutStatus])
  @@index([productId])
}

model DownloadToken {
  id            String   @id @default(cuid())
  token         String   @unique
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  maxDownloads  Int      @default(5)
  downloadCount Int      @default(0)
  createdAt     DateTime @default(now())
}

model Booking {
  id          String            @id @default(cuid())
  orderId     String            @unique
  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  slotId      String?           @unique
  slot        ConsultationSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  startsAt    DateTime
  meetingLink String?
  status      String            @default("CONFIRMED")
  createdAt   DateTime          @default(now())
}

model DeliveryLog {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  channel   String // "email"
  status    String // "sent" | "failed" | "unconfigured"
  detail    String?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model FunnelEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // "comment_detected" | "bio_visit" | "order_closed"
  metadata  String?
  createdAt DateTime @default(now())

  @@index([userId, type, createdAt])
}

model WebhookEvent {
  id        String   @id @default(cuid())
  provider  String // "meta" | "stripe" | "bkash"
  eventId   String
  createdAt DateTime @default(now())

  @@unique([provider, eventId])
}
