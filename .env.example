# ── Database ────────────────────────────────────────────────
# Local: SQLite   DATABASE_URL="file:./dev.db"
# Prod:  Postgres DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/omniflow?schema=public"
DATABASE_URL="file:./dev.db"

# ── Auth & app ──────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Used to encrypt creator gateway credentials and Meta page tokens.
ENCRYPTION_KEY="replace-with-another-long-random-string"

# ── File storage & delivery ─────────────────────────────────
STORAGE_DIR="./storage"
MAX_UPLOAD_MB="50"
DOWNLOAD_TTL_HOURS="72"

# ── Email (Resend) ──────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="OmniFlow <noreply@yourdomain.com>"

# ── Meta Graph API (Instagram + Facebook) ───────────────────
META_APP_ID=""
META_APP_SECRET=""
META_VERIFY_TOKEN="choose-a-webhook-verify-token"
META_GRAPH_VERSION="v21.0"

# ── Platform billing (OmniFlow subscriptions) ───────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_AGENCY=""

# Creator store gateways (Stripe key / bKash credentials) are entered per
# creator in Dashboard → Integrations and stored encrypted.
