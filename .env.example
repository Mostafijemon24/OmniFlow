# ── Database ────────────────────────────────────────────────
# Local: SQLite   DATABASE_URL="file:./dev.db"
# Prod:  Postgres DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/omniflow?schema=public"
DATABASE_URL="file:./dev.db"

# ── Auth & app ──────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Used to encrypt platform gateway credentials and Meta page tokens.
# Minimum 32 characters. Changing it makes existing stored credentials unreadable.
ENCRYPTION_KEY="replace-with-another-long-random-string"

# ── Super admin ─────────────────────────────────────────────
# The only way to become a super admin. Register an account with exactly this
# address to get the Platform Setup screens. Comma-separated for several admins.
# Leaving it empty means nobody is an admin and the admin routes answer 404.
SUPER_ADMIN_EMAIL="you@yourdomain.com"

# ── File storage & delivery ─────────────────────────────────
STORAGE_DIR="./storage"
MAX_UPLOAD_MB="50"
DOWNLOAD_TTL_HOURS="72"

# ── Email (Resend) ──────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="OmniFlow <noreply@yourdomain.com>"

# ── Stripe webhook signing ──────────────────────────────────
# The only Stripe value that stays in the environment: it is generated by the
# Stripe dashboard when you create the webhook endpoint, not by this app.
# The secret key and the three plan price IDs are configured by the super admin
# in Dashboard → Platform Setup and stored encrypted in the database.
STRIPE_WEBHOOK_SECRET=""

# Meta app credentials, the bKash number and the plan price IDs are all
# configured in Dashboard → Platform Setup. They are deliberately not
# environment variables: a running server cannot rewrite its own .env.
